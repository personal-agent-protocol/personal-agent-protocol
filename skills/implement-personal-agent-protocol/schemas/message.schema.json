{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "message.schema.json",
    "title": "Conversation message",
    "description": "A message in a Personal Agent Protocol conversation, from either side. Spec sections 7.3 (Sending messages) and 7.4 (Message fields). A message has at least one of text, data, or context. role is set by the Company when it records the message as an event; the Personal Agent doesn't send it. Unknown fields are allowed, for example ones an extension adds.",
    "type": "object",
    "required": ["id", "author"],
    "properties": {
        "id": { "$ref": "#/$defs/id" },
        "role": { "enum": ["user", "company"] },
        "text": { "type": "string" },
        "data": { "type": "object" },
        "author": {
            "type": "object",
            "required": ["type"],
            "properties": {
                "type": { "enum": ["agent", "human"] },
                "id": { "$ref": "#/$defs/id" },
                "name": { "type": "string", "minLength": 1 },
                "image": { "type": "string", "pattern": "^https://" }
            }
        },
        "context": {
            "type": "object",
            "properties": {
                "locale": { "type": "string", "minLength": 1 },
                "time_zone": { "type": "string", "minLength": 1 },
                "user_available": { "type": "boolean" }
            }
        }
    },
    "anyOf": [{ "required": ["text"] }, { "required": ["data"] }, { "required": ["context"] }],
    "$defs": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,256}$" }
    }
}
