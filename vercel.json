{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "redirects": [
        {
            "source": "/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "personalagentprotocol\\.ai"
                }
            ],
            "destination": "https://personalagentprotocol.org/:path*",
            "permanent": true
        },
        {
            "source": "/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "personalagentprotocol\\.net"
                }
            ],
            "destination": "https://personalagentprotocol.org/:path*",
            "permanent": true
        },
        {
            "source": "/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "personalagentprotocol\\.com"
                }
            ],
            "destination": "https://personalagentprotocol.org/:path*",
            "permanent": true
        },
        {
            "source": "/",
            "has": [
                {
                    "type": "query",
                    "key": "page",
                    "value": "spec"
                }
            ],
            "destination": "/docs/spec",
            "permanent": true
        },
        {
            "source": "/docs",
            "destination": "/docs/introduction",
            "permanent": false
        },
        {
            "source": "/docs/:version(\\d+\\.\\d+)",
            "destination": "/docs/:version/spec",
            "permanent": false
        },
        {
            "source": "/docs/spec",
            "destination": "/docs/0.3/spec",
            "permanent": false
        },
        {
            "source": "/docs/spec.md",
            "destination": "/docs/0.3/spec.md",
            "permanent": false
        },
        {
            "source": "/docs/extensions",
            "destination": "/docs/0.3/extensions",
            "permanent": false
        },
        {
            "source": "/docs/extensions.md",
            "destination": "/docs/0.3/extensions.md",
            "permanent": false
        },
        {
            "source": "/docs/extensions/operations",
            "destination": "/docs/0.3/extensions/operations",
            "permanent": false
        },
        {
            "source": "/docs/extensions/operations.md",
            "destination": "/docs/0.3/extensions/operations.md",
            "permanent": false
        },
        {
            "source": "/docs/extensions/mediated-sign-in",
            "destination": "/docs/0.3/extensions/mediated-sign-in",
            "permanent": false
        },
        {
            "source": "/docs/extensions/mediated-sign-in.md",
            "destination": "/docs/0.3/extensions/mediated-sign-in.md",
            "permanent": false
        },
        {
            "source": "/docs/guides",
            "destination": "/docs/0.3/guides",
            "permanent": false
        },
        {
            "source": "/docs/guides.md",
            "destination": "/docs/0.3/guides.md",
            "permanent": false
        },
        {
            "source": "/:page(spec|guides|extensions)",
            "destination": "/docs/:page",
            "permanent": true
        },
        {
            "source": "/:page(spec|guides|extensions).md",
            "destination": "/docs/:page.md",
            "permanent": true
        },
        {
            "source": "/overview",
            "destination": "/docs/introduction",
            "permanent": true
        },
        {
            "source": "/overview.md",
            "destination": "/docs/introduction.md",
            "permanent": true
        },
        {
            "source": "/docs/overview",
            "destination": "/docs/introduction",
            "permanent": true
        },
        {
            "source": "/docs/overview.md",
            "destination": "/docs/introduction.md",
            "permanent": true
        },
        {
            "source": "/docs/open-topics",
            "destination": "/docs/path-to-1#open-topics",
            "permanent": true
        },
        {
            "source": "/docs/open-topics.md",
            "destination": "/docs/path-to-1.md",
            "permanent": true
        },
        {
            "source": "/extensions/:path*",
            "destination": "/docs/extensions/:path*",
            "permanent": true
        },
        {
            "source": "/docs/personal-agent-protocol-docs.zip",
            "destination": "/kit/implement-personal-agent-protocol.zip",
            "permanent": true
        },
        {
            "source": "/kit/poppy-review.zip",
            "destination": "/kit/implement-personal-agent-protocol.zip",
            "permanent": true
        },
        {
            "source": "/kit/review",
            "destination": "/kit/company",
            "permanent": true
        },
        {
            "source": "/kit/review/:path*",
            "destination": "/kit/company/:path*",
            "permanent": true
        },
        {
            "source": "/kit",
            "destination": "/kit/company",
            "permanent": false
        }
    ],
    "headers": [
        {
            "source": "/docs/0.2/(.*)",
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex"
                }
            ]
        },
        {
            "source": "/docs/0.1/(.*)",
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=63072000; includeSubDomains"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://fast.wistia.com https://fast.wistia.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.wistia.com https://*.wistia.net; font-src 'self'; media-src 'self' blob: https://*.wistia.com https://*.wistia.net; connect-src 'self' https://*.wistia.com https://*.wistia.net; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'; upgrade-insecure-requests"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=()"
                }
            ]
        }
    ]
}
