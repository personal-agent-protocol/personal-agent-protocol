{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "dpop-proof.schema.json",
    "title": "DPoP Proof",
    "description": "A DPoP Proof (RFC 9449) as its decoded JWT header and payload. Spec section 4.3 (Using Session Tokens). The header and payload are also available on their own as dpop-proof.schema.json#/$defs/header and #/$defs/payload. ath is left out of proofs sent to the token endpoint and in a browser-session form, and nonce is present when the Company requires one. In a browser-session form, nonce is the form's code (spec section 5).",
    "type": "object",
    "required": ["header", "payload"],
    "properties": {
        "header": { "$ref": "#/$defs/header" },
        "payload": { "$ref": "#/$defs/payload" }
    },
    "$defs": {
        "header": {
            "type": "object",
            "required": ["typ", "alg", "jwk"],
            "properties": {
                "typ": { "const": "dpop+jwt" },
                "alg": { "type": "string", "not": { "enum": ["none", "HS256", "HS384", "HS512"] } },
                "jwk": {
                    "type": "object",
                    "required": ["kty"],
                    "properties": {
                        "kty": { "type": "string" },
                        "d": false,
                        "p": false,
                        "q": false,
                        "dp": false,
                        "dq": false,
                        "qi": false,
                        "k": false
                    }
                }
            }
        },
        "payload": {
            "type": "object",
            "required": ["jti", "htm", "htu", "iat"],
            "properties": {
                "jti": { "type": "string", "minLength": 1 },
                "htm": { "type": "string", "pattern": "^[A-Z]+$" },
                "htu": { "type": "string", "pattern": "^https://[^?#]+$" },
                "iat": { "type": "integer", "minimum": 0 },
                "ath": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
                "nonce": { "type": "string", "minLength": 1 }
            }
        }
    }
}
