{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "mediated-sign-in-response.schema.json",
    "title": "Mediated Sign-In response",
    "description": "The HTTP 200 response to a Mediated Sign-In request or code submission, by status. Spec section 4.7 (Mediated Sign-In). complete has the token response fields of 4.4, code_required has a sign_in_id, and failed and expired need nothing else. Errors with the request itself use error.schema.json. Unknown fields are allowed.",
    "type": "object",
    "required": ["status"],
    "properties": {
        "status": {
            "enum": ["complete", "code_required", "failed", "expired"]
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "status": {
                        "const": "complete"
                    }
                }
            },
            "then": {
                "allOf": [
                    {
                        "$ref": "token-response.schema.json"
                    },
                    {
                        "required": ["refresh_token"]
                    },
                    {
                        "properties": {
                            "scope": {
                                "minLength": 1
                            }
                        }
                    }
                ]
            }
        },
        {
            "if": {
                "properties": {
                    "status": {
                        "const": "code_required"
                    }
                }
            },
            "then": {
                "required": ["sign_in_id"],
                "properties": {
                    "sign_in_id": {
                        "type": "string",
                        "minLength": 1
                    },
                    "code": {
                        "type": "object",
                        "properties": {
                            "sent_to": {
                                "type": "string"
                            }
                        }
                    },
                    "expires_at": {
                        "$ref": "#/$defs/date_time"
                    }
                }
            }
        }
    ],
    "$defs": {
        "date_time": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})$"
        }
    }
}
