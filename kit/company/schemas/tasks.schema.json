{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "tasks.schema.json",
    "title": "Tasks response",
    "description": "The response to GET {tasks.endpoint}: the tasks a Company chose not to offer through the protocol, the skills it publishes, and its feedback endpoint, for one Session. Spec section 9, 9.1 (Excluded tasks), 9.3 (Feedback), and 9.4 (Agent context).",
    "type": "object",
    "properties": {
        "excluded_tasks": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["task"],
                "properties": {
                    "task": { "type": "string", "minLength": 1 },
                    "alternative": { "$ref": "alternative.schema.json" }
                }
            }
        },
        "skill_index": {
            "$ref": "skill-index.schema.json"
        },
        "feedback": {
            "type": "object",
            "required": ["endpoint"],
            "properties": {
                "endpoint": { "$ref": "poppy.schema.json#/$defs/https_url" }
            }
        }
    }
}
